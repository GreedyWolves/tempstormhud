<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The mod is distributed as a zip with the .cs source and assets (the game compiles it on startup).
    This project is used to:
      1) compile-check against the game's libraries (catches type/name errors before testing in game),
      2) package the zip into bin/,
      3) optionally copy the zip into VintagestoryData/Mods (dotnet build -p:Deploy=true).

    Requires the VINTAGE_STORY environment variable = game installation folder
    (by default %AppData%\Vintagestory). Game libraries are NOT committed to the repository.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>tempstormhud</AssemblyName>
    <RootNamespace>TempStormHud</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

    <ModId>tempstormhud</ModId>
    <ModVersion>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/modinfo.json')), '"version"\s*:\s*"([^"]+)"').Groups[1].Value)</ModVersion>
    <ModZipDir>$(MSBuildProjectDirectory)/bin/release</ModZipDir>
    <ModZipPath>$(ModZipDir)/$(ModId)_$(ModVersion).zip</ModZipPath>
    <ModStagingDir>$(BaseIntermediateOutputPath)modzip/</ModStagingDir>

    <!-- The game's Mods folder; override with: dotnet build -p:ModsDir=... -->
    <ModsDir Condition="'$(ModsDir)' == ''">$(APPDATA)/VintagestoryData/Mods</ModsDir>
    <Deploy Condition="'$(Deploy)' == ''">false</Deploy>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="VintagestoryAPI">
      <HintPath>$(VINTAGE_STORY)/VintagestoryAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- In case the compiler requires Cairo types (CairoFont). -->
    <Reference Include="cairo-sharp" Condition="Exists('$(VINTAGE_STORY)/Lib/cairo-sharp.dll')">
      <HintPath>$(VINTAGE_STORY)/Lib/cairo-sharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CheckVintageStoryPath" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(VINTAGE_STORY)' == ''"
           Text="The VINTAGE_STORY environment variable (game installation folder) is not set. Set it and restart the terminal/application." />
    <Error Condition="!Exists('$(VINTAGE_STORY)/VintagestoryAPI.dll')"
           Text="$(VINTAGE_STORY)/VintagestoryAPI.dll not found - check the VINTAGE_STORY variable." />
  </Target>

  <Target Name="PackageModZip" AfterTargets="Build">
    <Error Condition="'$(ModVersion)' == ''" Text="Could not read the version from modinfo.json." />

    <ItemGroup>
      <ModSourceFiles Include="$(MSBuildProjectDirectory)/src/**/*.cs" />
      <ModAssetFiles Include="$(MSBuildProjectDirectory)/assets/**/*" />
    </ItemGroup>

    <RemoveDir Directories="$(ModStagingDir)" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/modinfo.json" DestinationFolder="$(ModStagingDir)" />
    <Copy SourceFiles="@(ModSourceFiles)" DestinationFolder="$(ModStagingDir)src/%(RecursiveDir)" />
    <Copy SourceFiles="@(ModAssetFiles)" DestinationFolder="$(ModStagingDir)assets/%(RecursiveDir)" />

    <MakeDir Directories="$(ModZipDir)" />
    <ZipDirectory SourceDirectory="$(ModStagingDir)" DestinationFile="$(ModZipPath)" Overwrite="true" />
    <Message Importance="high" Text="Packaged: $(ModZipPath)" />
  </Target>

  <!-- Removes earlier versions of the mod from Mods so the game doesn't load two at once. -->
  <Target Name="DeployModZip" AfterTargets="PackageModZip" Condition="'$(Deploy)' == 'true'">
    <Error Condition="!Exists('$(ModsDir)')" Text="Mods folder not found: $(ModsDir)" />
    <ItemGroup>
      <OldModZips Include="$(ModsDir)/$(ModId)_*.zip" />
    </ItemGroup>
    <Delete Files="@(OldModZips)" />
    <Copy SourceFiles="$(ModZipPath)" DestinationFolder="$(ModsDir)" />
    <Message Importance="high" Text="Deployed to: $(ModsDir)" />
  </Target>

</Project>
